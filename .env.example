# Browser-safe public Supabase variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional aliases supported by the Vite build when a deployment platform uses Next-style names
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Frontend API origin
VITE_API_URL=http://localhost:8787
# Optional: set to the exact public preview/app origin; otherwise the browser origin is used
VITE_AUTH_REDIRECT_URL=

# Set true on the deployed backend to require Supabase bearer tokens on user-scoped routes
REQUIRE_AUTH=true

# Server-only values — never expose these in src/, VITE_*, NEXT_PUBLIC_*, or committed files
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Primary multimodal meal-analysis provider
GROQ_API_KEY=replace-with-server-only-groq-api-key
GROQ_MODEL=qwen/qwen3.6-27b

# Optional Gemini fallback
GEMINI_API_KEY=replace-with-server-only-gemini-api-key
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash
