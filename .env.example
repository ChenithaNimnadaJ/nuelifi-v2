# Browser-safe public Supabase variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional aliases supported by the Vite build when a deployment platform uses Next-style names
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Frontend API origin
VITE_API_URL=http://localhost:8787

# Paddle.js client configuration. Use production with a live_ token, or sandbox with a test_ token.
# Never put the Paddle server API key or webhook signing secret in VITE_* variables.
VITE_PADDLE_ENVIRONMENT=production
VITE_PADDLE_CLIENT_TOKEN=live_replace-with-paddle-client-side-token

# Paddle server-only values — configure these in the Cloudflare Worker secret store.
PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=replace-with-paddle-server-api-key
PADDLE_NOTIFICATION_WEBHOOK_SECRET=replace-with-paddle-notification-signing-secret
PADDLE_PRICE_PRO_MONTH=pri_replace-with-pro-month-price-id
PADDLE_PRICE_PRO_YEAR=pri_replace-with-pro-year-price-id
PADDLE_PRICE_PREMIUM_MONTH=pri_replace-with-premium-month-price-id
PADDLE_PRICE_PREMIUM_YEAR=pri_replace-with-premium-year-price-id
# Canonical production auth origin; the app appends /app or /welcome as appropriate.
# For local development, use the exact local origin or leave blank to use the browser origin.
VITE_AUTH_REDIRECT_URL=https://neulifi.online

# Set true on the deployed backend to require Supabase bearer tokens on user-scoped routes
REQUIRE_AUTH=true

# Server-only values — never expose these in src/, VITE_*, NEXT_PUBLIC_*, or committed files
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Primary multimodal meal-analysis provider
GROQ_API_KEY=replace-with-server-only-groq-api-key
GROQ_MODEL=qwen/qwen3.6-27b

# Free-tier Gemini key 1 (existing server-only credential)
GEMINI_API_KEY=replace-with-server-only-gemini-free-key-1
# Free-tier Gemini key 2 (separate server-only project credential)
GEMINI_API_KEY_2=replace-with-server-only-gemini-free-key-2
# Only model IDs that passed text, image, four-image, and structured-output checks are listed.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_KEY_1_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_KEY_2_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
